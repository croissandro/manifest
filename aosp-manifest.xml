<?xml version="1.0" encoding="UTF-8"?>
<!-- CroissAndro projects layered on top of the upstream AOSP manifest. -->
<manifest>

  <remote
    name="croissandro"
    fetch="https://github.com/croissandro/"
  />

  <project
    name="croissandro"
    path="device/croissandro"
    remote="croissandro"
    revision="main"
    groups="device,pdk"
  />

  <project
    name="kernel-prebuilts"
    path="prebuilts/kernel/croissandro/6.18"
    remote="croissandro"
    revision="main"
    groups="device,pdk"
  />

</manifest>

<?xml version="1.0" encoding="UTF-8"?>
<!-- CroissAndro manifest layered on top of the AOSP manifest submodule. -->
<manifest>
  <include name="aosp/default.xml" />

  <remote
    name="aosp"
    fetch="https://android.googlesource.com/a/"
    review="https://android-review.googlesource.com/"
  />

  <remote
    name="croissandro"
    fetch="https://github.com/croissandro/"
  />

  <project
    name="croissandro"
    path="device/croissandro"
    remote="croissandro"
    revision="main"
    groups="device,pdk"
  />

</manifest>
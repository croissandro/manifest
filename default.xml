<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote
    name="aosp"
    fetch="https://android.googlesource.com/a/"
    review="https://android-review.googlesource.com/a/"
  />

  <remote
    name="croissandro"
    fetch="https://github.com/croissandro"
  />

  <default
    revision="android-latest-release"
    remote="aosp"
    sync-j="4"
  />

  <project
    name="croissandro"
    path="device/croissandro"
    remote="croissandro"
    revision="main"
  />
</manifest>